generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Test {
  id               String   @id @default(cuid())
  code             String   @unique @db.NVarChar(50)
  name             String   @db.NVarChar(255)
  category         String   @db.NVarChar(100)
  price            Float
  originalPrice    Float?
  description      String?  @db.NVarChar(Max)
  sampleType       String?  @db.NVarChar(50)
  fastingRequired  Boolean  @default(false)
  reportTime       String?  @db.NVarChar(50)
  parameters       Int?
  popular          Boolean  @default(false)
  iconUrl          String?  @db.NVarChar(500)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  bookings         Booking[]
  packageTests     PackageTest[]
}

model Package {
  id            String        @id @default(cuid())
  code          String        @unique @db.NVarChar(50)
  name          String        @db.NVarChar(255)
  category      String        @db.NVarChar(100)
  description   String?       @db.NVarChar(Max)
  price         Float
  originalPrice Float?
  imageUrl      String?       @db.NVarChar(500)
  reportsTime   String?       @db.NVarChar(50)
  fasting       String?       @db.NVarChar(50)
  sampleType    String?       @db.NVarChar(50)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  packageTests  PackageTest[]
  bookings      Booking[]
}

model PackageTest {
  id        String   @id @default(cuid())
  packageId String
  testId    String?
  testName  String   @db.NVarChar(255)
  sortOrder Int      @default(0)
  package   Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  test      Test?    @relation(fields: [testId], references: [id], onDelete: SetNull)
}

model Booking {
  id          String   @id @default(cuid())
  name        String   @db.NVarChar(150)
  phone       String   @db.NVarChar(30)
  email       String?  @db.NVarChar(150)
  address     String?  @db.NVarChar(500)
  preferredDate String? @db.NVarChar(50)
  preferredTime String? @db.NVarChar(50)
  notes       String?  @db.NVarChar(Max)
  status      String   @default("pending") @db.NVarChar(30)
  testId      String?
  packageId   String?
  offerId     String?
  test        Test?    @relation(fields: [testId], references: [id])
  package     Package? @relation(fields: [packageId], references: [id])
  offer       Offer?   @relation(fields: [offerId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String   @db.NVarChar(150)
  email     String   @db.NVarChar(150)
  phone     String?  @db.NVarChar(30)
  subject   String?  @db.NVarChar(255)
  message   String   @db.NVarChar(Max)
  createdAt DateTime @default(now())
}

model Offer {
  id               String   @id @default(cuid())
  name             String   @db.NVarChar(255)
  category         String   @db.NVarChar(100)
  originalPrice    Float
  discountedPrice  Float
  discountPercent  Int      @default(0)
  reportsTime      String?  @db.NVarChar(50)
  fasting          String?  @db.NVarChar(50)
  sampleType       String?  @db.NVarChar(50)
  packageId        String?
  testId           String?
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  bookings         Booking[]
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String   @db.NVarChar(150)
  role      String?  @db.NVarChar(100)
  content   String   @db.NVarChar(Max)
  rating    Int      @default(5)
  imageUrl  String?  @db.NVarChar(500)
  featured  Boolean  @default(true)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model Category {
  id        String   @id @default(cuid())
  label     String   @db.NVarChar(100)
  slug      String   @unique @db.NVarChar(100)
  imageUrl  String?  @db.NVarChar(500)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}
