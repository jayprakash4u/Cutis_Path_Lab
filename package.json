{
  "name": "cutis-path-lab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "db:init": "sqlcmd -S localhost\\SQLEXPRESS -E -C -d CutisPathLab -i scripts/init-db.sql",
    "db:init-packages": "sqlcmd -S localhost\\SQLEXPRESS -E -C -d CutisPathLab -i scripts/init-packages.sql",
    "db:init-home": "sqlcmd -S localhost\\SQLEXPRESS -E -C -d CutisPathLab -i scripts/init-home-content.sql",
    "db:init-category-tests": "sqlcmd -S localhost\\SQLEXPRESS -E -C -d CutisPathLab -i scripts/init-category-tests.sql",
    "db:init-booking-checks": "sqlcmd -S localhost\\SQLEXPRESS -E -C -d CutisPathLab -i scripts/init-booking-checks.sql",
    "db:init-contact-checks": "sqlcmd -S localhost\\SQLEXPRESS -E -C -d CutisPathLab -i scripts/init-contact-checks.sql",
    "db:seed-tests": "node scripts/seed-tests.mjs",
    "db:seed-packages": "node scripts/seed-packages.mjs",
    "db:seed-home": "node scripts/seed-home-content.mjs",
    "db:seed-category-tests": "node scripts/seed-category-tests.mjs"
  },
  "dependencies": {
    "next": "^16.2.2",
    "nodemailer": "^9.0.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^9",
    "eslint-config-next": "^16.2.2",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
