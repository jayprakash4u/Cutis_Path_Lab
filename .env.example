# SQL Server settings for API routes (sqlcmd — local Windows dev)
SQLSERVER_HOST=localhost\SQLEXPRESS
SQLSERVER_DATABASE=CutisPathLab
# SQLSERVER_LOGIN_TIMEOUT=60
# Cache read queries in memory (ms) — speeds up repeat page loads during dev
# SQLSERVER_READ_CACHE_MS=120000
# Browser cache for public catalog APIs (seconds)
# PUBLIC_API_CACHE_SECONDS=60

# Public site URL (required in production for SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.cutispathlab.com

# --- Booking & contact email notifications (SMTP) ---
BOOKING_NOTIFY_EMAIL=info@cutispathlab.com
# Optional separate inbox for contact form (defaults to BOOKING_NOTIFY_EMAIL)
# CONTACT_NOTIFY_EMAIL=info@cutispathlab.com

# SMTP (example: Gmail — use an App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Cutis Path Lab <your-email@gmail.com>"

# --- Admin panel login ---
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-strong-password
# Required in production — generate a long random string (openssl rand -base64 32)
ADMIN_SESSION_SECRET=change-me-long-random-string
