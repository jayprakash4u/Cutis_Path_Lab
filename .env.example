# Prefer SQLEXPRESS for Prisma (not LocalDB)
# DATABASE_URL="sqlserver://localhost;instanceName=SQLEXPRESS;database=CutisPathLab;integratedSecurity=true;trustServerCertificate=true"
DATABASE_URL=""

# Optional SQL Server settings for API routes (sqlcmd)
SQLSERVER_HOST=localhost\SQLEXPRESS
SQLSERVER_DATABASE=CutisPathLab
# SQLSERVER_LOGIN_TIMEOUT=60

# --- Booking email notifications (SMTP) ---
# Lab inbox that receives every new booking:
BOOKING_NOTIFY_EMAIL=info@cutispathlab.com

# SMTP (example: Gmail — use an App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Cutis Path Lab <your-email@gmail.com>"

# --- Admin panel login ---
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-strong-password
ADMIN_SESSION_SECRET=change-me-long-random-string
